@PACKAGE_INIT@

if(NOT TARGET OpenMS::Core)
  set(_openms_package_prefix "${PACKAGE_PREFIX_DIR}")
  include(CMakeFindDependencyMacro)
  set(_openms_saved_module_path "${CMAKE_MODULE_PATH}")
  list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/Modules")
  find_dependency(CURL)
  find_dependency(Boost @Boost_VERSION_STRING@ EXACT COMPONENTS regex)
  find_package(Eigen3 3.4.0...<6 QUIET)
  if(NOT TARGET Eigen3::Eigen)
    find_dependency(Eigen3 3.4.0)
  endif()
  find_dependency(Arrow @Arrow_VERSION@ EXACT CONFIG)
  find_dependency(Parquet @Parquet_VERSION@ EXACT CONFIG)
  if(@OPENMP_FOUND@)
    find_dependency(Threads)
    find_dependency(OpenMP COMPONENTS CXX)
  endif()
  set(PACKAGE_PREFIX_DIR "${_openms_package_prefix}")
  unset(_openms_package_prefix)
  set(CMAKE_MODULE_PATH "${_openms_saved_module_path}")
  unset(_openms_saved_module_path)
endif()

set(OpenMS_VERSION "@OPENMS_PACKAGE_VERSION@")
set(OpenMS_SOURCE_REVISION "@OPENMS_SOURCE_REVISION@")
set(OpenMS_WITH_HDF5 "@WITH_HDF5@")
set(OpenMS_WITH_OPENTIMS "@WITH_OPENTIMS@")
set(OpenMS_WITH_THERMO_RAW "@WITH_THERMO_RAW@")
set(OpenMS_WITH_TDL "@ENABLE_TDL@")
set(OpenMS_WITH_ONNX "@WITH_ONNX@")
set(OpenMS_WITH_OPENMP "@OPENMP_FOUND@")
set(OpenMS_WITH_WNETALIGN "@WITH_WNETALIGN@")
set(OpenMS_WITH_OPENSWATH "@OPENMS_WITH_OPENSWATH@")
set(OpenMS_ARROW_VERSION "@Arrow_VERSION@")
set(OpenMS_PARQUET_VERSION "@Parquet_VERSION@")
set(OpenMS_ARROW_TARGET "@OPENMS_ARROW_TARGET@")
set(OpenMS_PARQUET_TARGET "@OPENMS_PARQUET_TARGET@")
set(OpenMS_CXX_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@")
set(OpenMS_CXX_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@")
set(OpenMS_BUILD_TYPE "@CMAKE_BUILD_TYPE@")
set(OpenMS_CXX_STANDARD 23)
set(OpenMS_SHARED_LIBS "@BUILD_SHARED_LIBS@")
set(OpenMS_ADDCXX_FLAGS "@CF_OPENMS_ADDCXX_FLAGS@")
set(OpenMS_CLASS_TESTING_ENABLED "@ENABLE_CLASS_TESTING@")
set(OpenMS_SOURCE_DIRTY "@OPENMS_SOURCE_DIRTY@")
set(OpenMS_BUILD_INFO_FILE "${CMAKE_CURRENT_LIST_DIR}/OpenMSBuildInfo.json")
set(OpenMS_DATA_DIR "@PACKAGE_INSTALL_SHARE_DIR@")
set(OpenMS_SHARE_DIR "${OpenMS_DATA_DIR}")
set(OPENMS_DATA_DIR "${OpenMS_DATA_DIR}")
set(OPENMS_SHARE_DIR "${OpenMS_DATA_DIR}")
set(OPENMS_BIN_DIR "@PACKAGE_INSTALL_BIN_DIR@")
set(OPENMS_LIB_DIR "@PACKAGE_INSTALL_LIB_DIR@")
set(OPENMS_DOC_DIR "@PACKAGE_INSTALL_DOC_DIR@")
set(OPENMS_ADDCXX_FLAGS "@CF_OPENMS_ADDCXX_FLAGS@")
foreach(_openms_arrow_target IN ITEMS "${OpenMS_ARROW_TARGET}" "${OpenMS_PARQUET_TARGET}")
  if(NOT TARGET "${_openms_arrow_target}")
    set(OpenMS_FOUND FALSE)
    set(OpenMS_NOT_FOUND_MESSAGE "SDK requires ${_openms_arrow_target}; use the same Arrow/Parquet build and linkage.")
    return()
  endif()
endforeach()
unset(_openms_arrow_target)
if(NOT TARGET OpenMS::Core)
  include("${CMAKE_CURRENT_LIST_DIR}/OpenMSTargets.cmake")
  set_property(TARGET OpenMS::Core PROPERTY OPENMS_SOURCE_REVISION "@OPENMS_SOURCE_REVISION@")
else()
  get_target_property(_openms_imported_revision OpenMS::Core OPENMS_SOURCE_REVISION)
  if(NOT _openms_imported_revision STREQUAL "@OPENMS_SOURCE_REVISION@")
    message(FATAL_ERROR "An OpenMS::Core target from a different source revision is already loaded")
  endif()
endif()
# Temporary target aliases keep existing external projects source-compatible.
if(NOT TARGET OpenMS)
  add_library(OpenMS ALIAS OpenMS::Core)
endif()
if(NOT TARGET OpenSwathAlgo)
  add_library(OpenSwathAlgo ALIAS OpenMS::OpenSwathAlgo)
endif()
get_target_property(OpenMS_INCLUDE_DIRECTORIES OpenMS::Core INTERFACE_INCLUDE_DIRECTORIES)
set(OpenMS_LIBRARIES OpenMS::Core)
set(OpenMS_Core_FOUND TRUE)
set(OpenMS_OpenSwathAlgo_FOUND TRUE)
set(OpenMS_TestSupport_FOUND FALSE)
if("TestSupport" IN_LIST OpenMS_FIND_COMPONENTS)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/OpenMSTestSupportConfig.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/OpenMSTestSupportConfig.cmake")
  else()
    set(OpenMS_NOT_FOUND_MESSAGE "Install the SDK TestSupport component to build downstream tests or FuzzyDiff.")
  endif()
endif()
check_required_components(OpenMS)
