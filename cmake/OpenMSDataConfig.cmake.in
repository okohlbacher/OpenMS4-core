# Compiler-free data/feature metadata for fixture consumers and suite registration.
@PACKAGE_INIT@
set(OpenMSData_VERSION "@OPENMS_PACKAGE_VERSION@")
set(OpenMSData_SOURCE_REVISION "@OPENMS_SOURCE_REVISION@")
set(OpenMS_VERSION "@OPENMS_PACKAGE_VERSION@")
set(OpenMS_SOURCE_REVISION "@OPENMS_SOURCE_REVISION@")
set_and_check(OpenMS_DATA_DIR "@PACKAGE_INSTALL_SHARE_DIR@")
set(OpenMS_SHARE_DIR "${OpenMS_DATA_DIR}")
set(OpenMS_TEST_DATA_DIR "${OpenMS_DATA_DIR}/test-data/core")
set(OpenMS_WITH_HDF5 "@WITH_HDF5@")
set(OpenMS_WITH_OPENTIMS "@WITH_OPENTIMS@")
set(OpenMS_WITH_THERMO_RAW "@WITH_THERMO_RAW@")
set(OpenMS_WITH_TDL "@ENABLE_TDL@")
set(OpenMS_WITH_ONNX "@WITH_ONNX@")
set(OpenMS_WITH_OPENMP "@OPENMP_FOUND@")
set(OpenMS_WITH_WNETALIGN "@WITH_WNETALIGN@")
set(OpenMS_WITH_OPENSWATH "@OPENMS_WITH_OPENSWATH@")
set(OpenMSData_TestSupport_FOUND FALSE)
if(IS_DIRECTORY "${OpenMS_TEST_DATA_DIR}")
  set(OpenMSData_TestSupport_FOUND TRUE)
endif()
if("TestSupport" IN_LIST OpenMSData_FIND_COMPONENTS AND NOT OpenMSData_TestSupport_FOUND)
  set(OpenMSData_NOT_FOUND_MESSAGE "Install the core TestSupport component to provide class-test fixtures")
endif()
check_required_components(OpenMSData)
