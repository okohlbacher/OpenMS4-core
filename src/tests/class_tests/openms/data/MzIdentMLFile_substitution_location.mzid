<?xml version="1.0" encoding="UTF-8"?>
<MzIdentML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://psidev.info/psi/pi/mzIdentML/1.1 http://psi-pi.googlecode.com/svn/trunk/schema/mzIdentML1.1.0.xsd"
	xmlns="http://psidev.info/psi/pi/mzIdentML/1.1"
	version="1.1.0"
	id="OpenMS_substitution_location"
	creationDate="2014-11-02T22:32:45">
<cvList>
	<cv id="PSI-MS" fullName="Proteomics Standards Initiative Mass Spectrometry Vocabularies"  uri="http://psidev.cvs.sourceforge.net/viewvc/*checkout*/psidev/psi/psi-ms/mzML/controlledVocabulary/psi-ms.obo" version="3.15.0"></cv>
	<cv id="UNIMOD" fullName="UNIMOD"        uri="http://www.unimod.org/obo/unimod.obo"></cv>
	<cv id="UO"     fullName="UNIT-ONTOLOGY" uri="http://obo.cvs.sourceforge.net/*checkout*/obo/obo/ontology/phenotype/unit.obo"></cv>
</cvList>
<AnalysisSoftwareList>
	<AnalysisSoftware version="2.1.0" name="Mascot" id="SOF_1">
		<SoftwareName>
			<cvParam accession="MS:1001207" cvRef="PSI-MS" name="Mascot"/>
		</SoftwareName>
	</AnalysisSoftware>
</AnalysisSoftwareList>
<SequenceCollection>
	<DBSequence accession="PROT1" searchDatabase_ref="DB_1" length="34" id="DBS_1">
	<Seq>PEPTIDEKPEPTIDEMPEPTIDERPEPTIDECKR</Seq>
		<cvParam accession="MS:1001088" cvRef="PSI-MS" name="protein description" value="PROT1"/></DBSequence>
	<!-- Valid SubstitutionModification: P at location 3 (not the first P) becomes A, giving PEATIDEK -->
	<Peptide id="PEP_sub_valid">
		<PeptideSequence>PEPTIDEK</PeptideSequence>
		<SubstitutionModification location="3" originalResidue="P" replacementResidue="A"/>
	</Peptide>
	<!-- Location 0 is before the first residue: the Peptide is unreadable (empty sequence) -->
	<Peptide id="PEP_sub_zero">
		<PeptideSequence>PEPTIDEK</PeptideSequence>
		<SubstitutionModification location="0" originalResidue="P" replacementResidue="A"/>
	</Peptide>
	<!-- A negative location: the Peptide is unreadable (empty sequence) -->
	<Peptide id="PEP_sub_negative">
		<PeptideSequence>PEPTIDEK</PeptideSequence>
		<SubstitutionModification location="-5" originalResidue="P" replacementResidue="A"/>
	</Peptide>
	<!-- Location 9 is one past the 8 residues: the Peptide is unreadable (empty sequence) -->
	<Peptide id="PEP_sub_beyond">
		<PeptideSequence>PEPTIDEK</PeptideSequence>
		<SubstitutionModification location="9" originalResidue="K" replacementResidue="R"/>
	</Peptide>
	<!-- Valid SubstitutionModification at the first residue (location 1): P becomes A, giving AEPTIDEK -->
	<Peptide id="PEP_sub_first">
		<PeptideSequence>PEPTIDEK</PeptideSequence>
		<SubstitutionModification location="1" originalResidue="P" replacementResidue="A"/>
	</Peptide>
	<!-- Valid SubstitutionModification at the last residue (location 8, the sequence length): K becomes R, giving PEPTIDER -->
	<Peptide id="PEP_sub_last">
		<PeptideSequence>PEPTIDEK</PeptideSequence>
		<SubstitutionModification location="8" originalResidue="K" replacementResidue="R"/>
	</Peptide>
	<!-- SubstitutionModification without replacementResidue: the Peptide is unreadable (empty sequence) -->
	<Peptide id="PEP_sub_no_replacement">
		<PeptideSequence>PEPTIDEK</PeptideSequence>
		<SubstitutionModification location="3" originalResidue="P"/>
	</Peptide>
	<PeptideEvidence id="PEV_sub_valid" peptide_ref="PEP_sub_valid" dBSequence_ref="DBS_1" post="P" pre="K" isDecoy="0"/>
	<PeptideEvidence id="PEV_sub_zero" peptide_ref="PEP_sub_zero" dBSequence_ref="DBS_1" post="P" pre="K" isDecoy="0"/>
	<PeptideEvidence id="PEV_sub_negative" peptide_ref="PEP_sub_negative" dBSequence_ref="DBS_1" post="P" pre="K" isDecoy="0"/>
	<PeptideEvidence id="PEV_sub_beyond" peptide_ref="PEP_sub_beyond" dBSequence_ref="DBS_1" post="P" pre="K" isDecoy="0"/>
	<PeptideEvidence id="PEV_sub_first" peptide_ref="PEP_sub_first" dBSequence_ref="DBS_1" post="P" pre="K" isDecoy="0"/>
	<PeptideEvidence id="PEV_sub_last" peptide_ref="PEP_sub_last" dBSequence_ref="DBS_1" post="P" pre="K" isDecoy="0"/>
	<PeptideEvidence id="PEV_sub_no_replacement" peptide_ref="PEP_sub_no_replacement" dBSequence_ref="DBS_1" post="P" pre="K" isDecoy="0"/>
</SequenceCollection>
<AnalysisCollection>
	<SpectrumIdentification id="SI_1" spectrumIdentificationProtocol_ref="SIP_1" spectrumIdentificationList_ref="SIL_1" activityDate="2006-01-12T12:13:14">
		<InputSpectra spectraData_ref="SDAT_1"/>
		<SearchDatabaseRef searchDatabase_ref="DB_1"/>
	</SpectrumIdentification>
</AnalysisCollection>
<AnalysisProtocolCollection>
	<SpectrumIdentificationProtocol id="SIP_1" analysisSoftware_ref="SOF_1">
		<SearchType>
			<cvParam accession="MS:1001083" cvRef="PSI-MS" name="ms-ms search"/>
		</SearchType>
		<AdditionalSearchParams>
			<userParam name="charges" unitName="xsd:string" value="+1, +2"/>
		</AdditionalSearchParams>
		<Enzymes independent="false">
			<Enzyme missedCleavages="1" id="ENZ_1">
				<EnzymeName>
					<cvParam accession="MS:1001251" cvRef="PSI-MS" name="Trypsin"/>
				</EnzymeName>
			</Enzyme>
		</Enzymes>
		<Threshold>
			<cvParam accession="MS:1001494" cvRef="PSI-MS" name="no threshold"/>
		</Threshold>
	</SpectrumIdentificationProtocol>
</AnalysisProtocolCollection>
<DataCollection>
	<Inputs>
		<SearchDatabase location="MSDB" version="1.2.3" id="DB_1" >
			<FileFormat>
				<cvParam accession="MS:1001348" cvRef="PSI-MS" name="FASTA format"/>
			</FileFormat>
			<DatabaseName>
				<userParam name="MSDB"/>
			</DatabaseName>
		</SearchDatabase>
		<SpectraData location="UNKNOWN" id="SDAT_1">
			<FileFormat>
				<cvParam accession="MS:1000584" cvRef="PSI-MS" name="mzML format"/>
			</FileFormat>
			<SpectrumIDFormat>
				<cvParam accession="MS:1000774" cvRef="PSI-MS" name="multiple peak list nativeID format"/>
			</SpectrumIDFormat>
		</SpectraData>
	</Inputs>
	<AnalysisData>
		<SpectrumIdentificationList id="SIL_1">
			<SpectrumIdentificationResult spectraData_ref="SDAT_1" spectrumID="index=1" id="SIR_1">
				<SpectrumIdentificationItem passThreshold="1" rank="1" peptide_ref="PEP_sub_valid" calculatedMassToCharge="500.0" experimentalMassToCharge="500.0" chargeState="2" id="SII_1">
					<PeptideEvidenceRef peptideEvidence_ref="PEV_sub_valid"/>
					<cvParam accession="MS:1002354" cvRef="PSI-MS" name="PSM-level q-value" value="0.01"/>
				</SpectrumIdentificationItem>
				<cvParam accession="MS:1000894" cvRef="PSI-MS" name="retention time" value="10.0"/>
			</SpectrumIdentificationResult>
			<SpectrumIdentificationResult spectraData_ref="SDAT_1" spectrumID="index=2" id="SIR_2">
				<SpectrumIdentificationItem passThreshold="1" rank="1" peptide_ref="PEP_sub_zero" calculatedMassToCharge="500.0" experimentalMassToCharge="500.0" chargeState="2" id="SII_2">
					<PeptideEvidenceRef peptideEvidence_ref="PEV_sub_zero"/>
					<cvParam accession="MS:1002354" cvRef="PSI-MS" name="PSM-level q-value" value="0.02"/>
				</SpectrumIdentificationItem>
				<cvParam accession="MS:1000894" cvRef="PSI-MS" name="retention time" value="20.0"/>
			</SpectrumIdentificationResult>
			<SpectrumIdentificationResult spectraData_ref="SDAT_1" spectrumID="index=3" id="SIR_3">
				<SpectrumIdentificationItem passThreshold="1" rank="1" peptide_ref="PEP_sub_negative" calculatedMassToCharge="500.0" experimentalMassToCharge="500.0" chargeState="2" id="SII_3">
					<PeptideEvidenceRef peptideEvidence_ref="PEV_sub_negative"/>
					<cvParam accession="MS:1002354" cvRef="PSI-MS" name="PSM-level q-value" value="0.03"/>
				</SpectrumIdentificationItem>
				<cvParam accession="MS:1000894" cvRef="PSI-MS" name="retention time" value="30.0"/>
			</SpectrumIdentificationResult>
			<SpectrumIdentificationResult spectraData_ref="SDAT_1" spectrumID="index=4" id="SIR_4">
				<SpectrumIdentificationItem passThreshold="1" rank="1" peptide_ref="PEP_sub_beyond" calculatedMassToCharge="500.0" experimentalMassToCharge="500.0" chargeState="2" id="SII_4">
					<PeptideEvidenceRef peptideEvidence_ref="PEV_sub_beyond"/>
					<cvParam accession="MS:1002354" cvRef="PSI-MS" name="PSM-level q-value" value="0.04"/>
				</SpectrumIdentificationItem>
				<cvParam accession="MS:1000894" cvRef="PSI-MS" name="retention time" value="40.0"/>
			</SpectrumIdentificationResult>
			<SpectrumIdentificationResult spectraData_ref="SDAT_1" spectrumID="index=5" id="SIR_5">
				<SpectrumIdentificationItem passThreshold="1" rank="1" peptide_ref="PEP_sub_first" calculatedMassToCharge="500.0" experimentalMassToCharge="500.0" chargeState="2" id="SII_5">
					<PeptideEvidenceRef peptideEvidence_ref="PEV_sub_first"/>
					<cvParam accession="MS:1002354" cvRef="PSI-MS" name="PSM-level q-value" value="0.05"/>
				</SpectrumIdentificationItem>
				<cvParam accession="MS:1000894" cvRef="PSI-MS" name="retention time" value="50.0"/>
			</SpectrumIdentificationResult>
			<SpectrumIdentificationResult spectraData_ref="SDAT_1" spectrumID="index=6" id="SIR_6">
				<SpectrumIdentificationItem passThreshold="1" rank="1" peptide_ref="PEP_sub_last" calculatedMassToCharge="500.0" experimentalMassToCharge="500.0" chargeState="2" id="SII_6">
					<PeptideEvidenceRef peptideEvidence_ref="PEV_sub_last"/>
					<cvParam accession="MS:1002354" cvRef="PSI-MS" name="PSM-level q-value" value="0.06"/>
				</SpectrumIdentificationItem>
				<cvParam accession="MS:1000894" cvRef="PSI-MS" name="retention time" value="60.0"/>
			</SpectrumIdentificationResult>
			<SpectrumIdentificationResult spectraData_ref="SDAT_1" spectrumID="index=7" id="SIR_7">
				<SpectrumIdentificationItem passThreshold="1" rank="1" peptide_ref="PEP_sub_no_replacement" calculatedMassToCharge="500.0" experimentalMassToCharge="500.0" chargeState="2" id="SII_7">
					<PeptideEvidenceRef peptideEvidence_ref="PEV_sub_no_replacement"/>
					<cvParam accession="MS:1002354" cvRef="PSI-MS" name="PSM-level q-value" value="0.07"/>
				</SpectrumIdentificationItem>
				<cvParam accession="MS:1000894" cvRef="PSI-MS" name="retention time" value="70.0"/>
			</SpectrumIdentificationResult>
		</SpectrumIdentificationList>
	</AnalysisData>
</DataCollection>
</MzIdentML>
