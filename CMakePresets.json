{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "core-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "OPENMS_USE_VCPKG": "OFF",
        "BOOST_USE_STATIC": "OFF",
        "ARROW_USE_STATIC": "OFF",
        "ENABLE_CLASS_TESTING": "ON",
        "OPENMS_BUILD_TEST_SUPPORT": "ON",
        "WITH_OPENTIMS": "OFF",
        "WITH_THERMO_RAW": "OFF",
        "WITH_WNETALIGN": "OFF",
        "ENABLE_TDL": "OFF",
        "WITH_ONNX": "OFF",
        "WITH_HDF5": "OFF",
        "ENABLE_OPENTIMS_TESTS": "OFF",
        "ENABLE_THERMO_RAW_TESTS": "OFF",
        "ENABLE_THERMO_FAIMS_DIA_TESTS": "OFF"
      }
    },
    {
      "name": "core-debug",
      "displayName": "Core SDK Debug",
      "inherits": "core-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "core-release",
      "displayName": "Core SDK Release",
      "inherits": "core-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "core-debug",
      "configurePreset": "core-debug",
      "configuration": "Debug"
    },
    {
      "name": "core-release",
      "configurePreset": "core-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "core-debug",
      "configurePreset": "core-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "core-release",
      "configurePreset": "core-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
